# 核心进程配置。systemd EnvironmentFile 与 shell source 均可读取。
# 配置说明以设计/部署.md为准；行尾不写注释。
IOALAB_MODE=trial
IOALAB_BIND=127.0.0.1
IOALAB_PORT=8750
IOALAB_PUBLIC_URL=http://10.0.0.2:8750
IOALAB_DATA=/var/lib/ioalab/data
A2C_CACHE_DIR=/var/lib/ioalab/a2c-cache
PYTHONUTF8=1
IOALAB_ADMIN_PASSWORD=change-me-please-12
IOALAB_SECRET=change-me-64-hex
# 发现模型可选；留空使用确定性检索。官方服务模型在九问中独立配置。
IOALAB_LLM_API_KEY=
IOALAB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IOALAB_LLM_MODEL=qwen3.7-flash
IOALAB_A2X_MODEL=qwen-flash
IOALAB_EMBED_MODEL=text-embedding-v4
IOALAB_LLM_CONCURRENCY=4
IOALAB_REGISTRATION=open
IOALAB_LOGIN_CREDIT=100
IOALAB_ISC_COUNT=10
IOALAB_AUTOSEED=1
# 核心不产生背景委托；使用experiments/traffic.py。
IOALAB_TRAFFIC=off
