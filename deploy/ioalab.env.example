# 核心进程配置。systemd EnvironmentFile 与 shell source 均可读取。
# 配置说明以设计/部署.md为准；行尾不写注释。
IOALAB_MODE=trial
IOALAB_BIND=127.0.0.1
IOALAB_PORT=8750
IOALAB_PUBLIC_URL=http://10.0.0.2:8750
IOALAB_DATA=/var/lib/ioalab/data
A2C_CACHE_DIR=/var/lib/ioalab/a2c-cache
PYTHONUTF8=1
IOALAB_ADMIN_PASSWORD=change-me-please-12
IOALAB_SECRET=change-me-64-hex
# 发现模型可选；留空使用确定性检索。官方服务模型在九问中独立配置。
IOALAB_LLM_API_KEY=
IOALAB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IOALAB_LLM_MODEL=qwen3.7-flash
IOALAB_A2X_MODEL=qwen-flash
IOALAB_EMBED_MODEL=text-embedding-v4
IOALAB_LLM_CONCURRENCY=4
IOALAB_REGISTRATION=open
IOALAB_LOGIN_CREDIT=100
IOALAB_ISC_COUNT=10
IOALAB_AUTOSEED=1
IOALAB_SEED_FILE=/opt/ioalab/deploy/default-seed.json
IOALAB_BUNDLES_DIR=/opt/ioalab/dist
IOALAB_CONNECTION_TICKET_SECONDS=60
IOALAB_WS_HEARTBEAT_SECONDS=15
IOALAB_WS_LEASE_SECONDS=45
# 核心不产生背景委托；使用experiments/traffic.py。
# 邮件传输及OAuth属于独立客户端：IOALAB_NOTIFICATION_TRANSPORT/IOALAB_SMTP_AUTH/IOALAB_SMTP_CLIENT_ID配置见personal-assistant.env.example，不注入核心。
# 本地时间安排同属独立客户端：IOALAB_CALENDAR_BACKEND/IOALAB_SCHEDULE_FILE见personal-assistant.env.example，不注入核心。
IOALAB_TRAFFIC=off
# 独立服务进程使用Process SDK的model.list selection_key；不是网页mdl_资源ID。
# 留空使用九问默认选择；启动时只读校验可用性。
IOALAB_SERVICE_MODEL=
# ISC_001管理员助手密码；trial留空生成到data/assistant.secret，不输出到日志。
IOALAB_ASSISTANT_PASSWORD=
IOALAB_MESSAGE_RETENTION_DAYS=30
IOALAB_MESSAGE_METADATA_DAYS=90
IOALAB_MESSAGE_PENDING_LIMIT=1000
IOALAB_MESSAGE_RATE=60
IOALAB_MESSAGE_TTL_DAYS=7

# Optional: explicit L2 arbitration model registry; empty rejects skill contracts.
IOALAB_ARBITRATION_MODELS={}

# SDK-only optional client preference; core does not read this setting.
# Set in skill settings.local.json or the assistant process environment.
# IOALAB_MIN_QUOTES=1
