# 九问IoA仿真平台（Jiuwen IoA Lab）运行配置 —— 复制为 /etc/ioalab/ioalab.env 后按需修改（install.sh 会自动生成口令与密钥）。
# 全部配置只来自这里；平台不读任何凭据文件。改 IOALAB_PUBLIC_URL 须 `ioalab reset` 后重新 init（参与方 id 内嵌它）。

# ── 运行模式与地址 ─────────────────────────────────────────────────
IOALAB_MODE=trial                         # dev（本机开发）· trial（服务器：限速 · 关 /api/docs · 口令与 key 必填）
IOALAB_BIND=127.0.0.1                     # 监听地址；Nginx 反代时保持回环
IOALAB_PORT=8750
IOALAB_PUBLIC_URL=http://10.0.0.2:8750    # 浏览器与九问 swarm 访问的地址（内网 IP 或域名；HTTPS 写 https://…）
IOALAB_DATA=/var/lib/ioalab/data          # SQLite · 私钥 · 交付件 · A2X 数据集 · 回放 · 日志
A2C_CACHE_DIR=/var/lib/ioalab/a2c-cache   # 验收器沙箱的 wasm 运行时解压处（install.sh 预热）
PYTHONUTF8=1

# ── 口令与密钥（install.sh 生成；也可自填）────────────────────────
IOALAB_ADMIN_PASSWORD=change-me-please-12
IOALAB_SECRET=change-me-64-hex

# ── 模型（部署方自己的 API key；助手 · 服务方 · A2X 分类树检索共用）─
IOALAB_LLM_API_KEY=sk-xxxxxxxx
IOALAB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 任何 OpenAI 兼容端点
#IOALAB_LLM_BASE_URL_FALLBACK=                                        # 可选：备用端点（同一把 key），连续连接失败时自动切换
IOALAB_LLM_MODEL=qwen3.7-flash            # 助手与服务方
IOALAB_A2X_MODEL=qwen-flash               # A2X 分类树导航
IOALAB_EMBED_MODEL=text-embedding-v4      # 向量重排 / 退路
IOALAB_LLM_CONCURRENCY=4

# ── 账号与经济 ─────────────────────────────────────────────────────
IOALAB_REGISTRATION=open                  # open（用户名密码即可注册）· invite（需管理员邀请码）· closed
IOALAB_LOGIN_CREDIT=100                   # 每日首次登录赠送的虚拟币
IOALAB_ISC_COUNT=10                       # 内部服务使用者账号数 M（ISC_001…）；ISP 数 N 由 ioalab/seed/domains/ 文件数决定
IOALAB_NEEDS_PER_DAY=20                   # 每账号每日需求上限

# ── 种子与流量 ─────────────────────────────────────────────────────
IOALAB_AUTOSEED=1                         # 首次启动自动注入内部账号 · 服务 · 分类树
IOALAB_TRAFFIC=off                        # off · low · normal：内部用户的背景委托流量（管理员页也可开关）
