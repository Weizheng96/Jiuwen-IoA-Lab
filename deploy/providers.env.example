# Official participant process; separate from the core environment.
IOALAB_BASE_URL=http://127.0.0.1:8750
IOALAB_PROVIDER_BIND=127.0.0.1
IOALAB_PROVIDER_PORT=8751
IOALAB_PROVIDER_PUBLIC_URL=http://127.0.0.1:8751
IOALAB_PROVIDER_DATA=/var/lib/ioalab/providers
IOALAB_PROVIDER_CONCURRENCY=2
# Install/configure Jiuwen as this service user. Supply its full executable path if needed.
IOALAB_SWARM_COMMAND='["jiuwenswarm-process"]'
JIUWENSWARM_DATA_DIR=/var/lib/ioalab/swarm
A2C_CACHE_DIR=/var/lib/ioalab/provider-a2c-cache
# Explicit testing only; never enable when verifying real Jiuwen execution.
# IOALAB_STUB=1
