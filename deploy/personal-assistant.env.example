# 与核心进程环境分开；复制到忽略的 data/personal-assistant.env。
IOALAB_BASE_URL=http://127.0.0.1:8750
IOALAB_USERNAME=ISC_001
IOALAB_PASSWORD=change-me-use-the-generated-ISC001-password
IOALAB_HOME=data/personal-assistant
# 九问真实 WebChannel，绑定专用用户。只对回环或受保护网络开放。
IOALAB_SWARM_WS=ws://127.0.0.1:19000/ws?user_id=ioa-admin
IOALAB_SWARM_BRIDGE_SECRET=
IOALAB_RECIPIENT_EMAIL=zhengw.cc@outlook.com
# Microsoft 应用（客户端）ID，不是密钥。需允许个人账号、公共客户端流程。
IOALAB_GRAPH_CLIENT_ID=
# 通知邮箱通过 STARTTLS/SSL 发邀请，组织者为该邮箱；不要填管理员邮箱密码。
IOALAB_NOTIFICATION_TRANSPORT=smtp
# AgentMail通过personal-assistant/agentmail.py注册并验证后自动写入SMTP配置，API key不入库。
# AgentMail会议邀请设transport=agentmail，通过官方Calendar API发送，复用下方邮箱/API key。
# Outlook选择oauth2；使用设备码登录通知邮箱，不填SMTP密码。
IOALAB_SMTP_AUTH=password
# 可留空，复用 IOALAB_GRAPH_CLIENT_ID；同一个应用，两份独立授权。
IOALAB_SMTP_CLIENT_ID=
IOALAB_SMTP_HOST=
IOALAB_SMTP_PORT=587
IOALAB_SMTP_FROM=
IOALAB_SMTP_USERNAME=
IOALAB_SMTP_PASSWORD=
# JSON；不设置白名单即允许所有已登录账号；[] 为禁止所有发送者。
IOALAB_ALLOWED_SENDERS=
IOALAB_APPOINTMENT_RULES={"timeZone":"Asia/Shanghai","weekdays":[0,1,2,3,4],"startHour":9,"endHour":18,"minMinutes":15,"maxMinutes":120,"leadMinutes":30,"daysAhead":30}
