{
  "id": "wechat-posts",
  "name": "朋友圈文案工坊",
  "description": "为小店写朋友圈文案：三条短文案，每条不超过 60 字，必须出现店名；预批准型，6 虚拟币，当天交付。",
  "tags": [
    "文案",
    "朋友圈",
    "营销"
  ],
  "runnable": true,
  "formation": "preapproval",
  "deliverable": {
    "name": "posts",
    "title": "朋友圈文案",
    "file": "posts.json",
    "mediaType": "application/json",
    "description": "JSON：{\"posts\": [三条文案]}，每条 ≤ 60 字且含店名",
    "specSchema": {
      "shop": {
        "type": "string",
        "maxLength": 40
      },
      "theme": {
        "type": "string",
        "maxLength": 200
      },
      "count": {
        "const": 3
      },
      "maxChars": {
        "const": 60
      }
    }
  },
  "inputs": [],
  "deadlines": {
    "respondWithin": "PT10M",
    "startWithin": "PT30M",
    "deliverWithin": "PT30M",
    "acceptWithin": "PT15M"
  },
  "pricing": {
    "price": "6"
  },
  "verifier": {
    "id": "wechat_posts@1.0",
    "reads": [
      "spec.posts.shop",
      "spec.posts.count",
      "spec.posts.maxChars"
    ]
  },
  "notCovered": [
    "文采"
  ],
  "generator": {
    "system": "你是一位擅长小店营销的文案写手。按规格里的店名与主题，写出规定条数的朋友圈文案；每条不超过规定字数，每条都要自然地带上店名；口语、有画面感、不夸大。",
    "output": "{\"posts\": [\"文案1\", \"文案2\", \"文案3\"]}"
  },
  "sample": {
    "posts": [
      "小满美甲今天上新了春日奶油色，做完指尖像抹了一层云。",
      "周末约闺蜜来小满美甲，两人同行第二位八折。",
      "小满美甲的卸甲护理只要三十分钟，午休就能顺路来。"
    ]
  },
  "sample_spec": {
    "shop": "小满美甲",
    "theme": "春日上新"
  }
}