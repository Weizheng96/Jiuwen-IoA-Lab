[Unit]
Description=Pinned independent Jiuwen Swarm for the IoA administrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ioalab
Group=ioalab
WorkingDirectory=/var/lib/ioalab
Environment=JIUWENSWARM_DATA_DIR=/var/lib/ioalab/swarm
ExecStart=/opt/ioalab/.swarm-venv/bin/python -m jiuwenswarm.start_services all
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/ioalab

[Install]
WantedBy=multi-user.target
